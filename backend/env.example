# Copie este arquivo para .env (uso local) ou configure as mesmas chaves
# como Environment Variables no Render. Nenhum valor real deve ser commitado.

# URL JDBC do PostgreSQL. Provedores como Aiven/Render fornecem no formato
# postgres://usuario:senha@host:porta/banco — troque para jdbc:postgresql://
# e mantenha ?sslmode=require se o provedor exigir conexão criptografada.
DATABASE_URL=jdbc:postgresql://localhost:5432/comanda_digital

DATABASE_USERNAME=postgres
DATABASE_PASSWORD=

# Chave usada para assinar os tokens JWT. Gere uma string longa e aleatória
# própria — nunca reutilize o valor de exemplo/padrão do código.
JWT_SECRET=troque-por-uma-string-aleatoria-longa

# URL(s) do frontend autorizadas a chamar a API (CORS). Múltiplas URLs
# separadas por vírgula.
CORS_ORIGIN=http://localhost:4200

# Injetada automaticamente pelo Render em produção — não precisa definir.
PORT=8080
